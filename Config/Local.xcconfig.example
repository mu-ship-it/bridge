// Copy to Config/Local.xcconfig (gitignored) and fill in. Then: xcodegen generate
BRIDGE_BUNDLE_ID = com.yourname.bridge
DEVELOPMENT_TEAM = ABCDE12345
// Optional: override the Settings prefill. "//" starts a comment in xcconfig — keep the $() between the slashes.
BRIDGE_DEFAULT_SERVER_URL = https:/$()/your-server.example.com
